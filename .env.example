# Copy to .env.local for local development. Never commit real secrets.
# Neon Auth URL for the active Neon branch (available in Neon Console).
NEXT_PUBLIC_NEON_AUTH_URL=

# Neon PostgreSQL pooled connection string. Server-side only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Canonical app URL used for OAuth callback/redirect configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required by the catalogue moderation API. Set as a Cloudflare Pages secret, never expose publicly.
STAGELOG_ADMIN_TOKEN=
